# Application
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
APP_DOMAIN=localhost:5173
BASE_DOMAIN=app.example.com

# PostgreSQL Database URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/unified_dental?schema=public"

# Authentication & JWT
JWT_SECRET="unified-dental-secure-jwt-secret-key-2026"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Redis & Background Queue (BullMQ)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0
REDIS_PREFIX="unified"

# SMTP / Mail Service
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="no-reply@unifieddental.com"
SMTP_PASS="secret"
SMTP_FROM="\"Unified Dental Platform\" <no-reply@unifieddental.com>"

# Storage
UPLOAD_DIR="./uploads"

# Internationalization
DEFAULT_LOCALE="en"
FALLBACK_LOCALE="en"
